# Inclina: que el navegador y Cloudflare no se queden con versiones viejas de la app.
# (Apache / IONOS / Hostinger. Si el hosting es Nginx, este archivo se ignora sin dañar nada.)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(woff2|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
